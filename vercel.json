{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/css/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/css/:match*" },
    { "source": "/js/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/js/:match*" },
    { "source": "/api/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/api/:match*" },
    { "source": "/admin/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/admin/:match*" },
    { "source": "/faculty/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/faculty/:match*" },
    { "source": "/student/:match*", "destination": "https://attendex-backend-wtd1.onrender.com/student/:match*" },
    { "source": "/login", "destination": "https://attendex-backend-wtd1.onrender.com/login" },
    { "source": "/logout", "destination": "https://attendex-backend-wtd1.onrender.com/logout" },
    { "source": "/", "destination": "/index.html" }
  ]
}
